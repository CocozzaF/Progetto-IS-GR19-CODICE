<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="Boundary.BoundaryVisualizzaLezione">
  <grid id="27dc6" binding="mainPanel" layout-manager="BorderLayout" hgap="10" vgap="10">
    <constraints>
      <xy x="20" y="20" width="700" height="500"/>
    </constraints>
    <properties/>
    <border type="empty">
      <size top="15" left="15" bottom="15" right="15"/>
    </border>
    <children>
      <grid id="f4a3a" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="0">
        <constraints border-constraint="North"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="a1b2c" class="javax.swing.JLabel">
            <constraints/>
            <properties>
              <text value="Seleziona Classe: "/>
            </properties>
          </component>
          <component id="d3e4f" class="javax.swing.JComboBox" binding="comboClassi">
            <constraints/>
            <properties>
              <preferredSize width="250" height="30"/>
            </properties>
          </component>
        </children>
      </grid>
      <scrollpane id="e5f6g">
        <constraints border-constraint="Center"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="h7i8j" class="javax.swing.JTable" binding="tableLezioni">
            <constraints/>
            <properties>
              <rowHeight value="25"/>
            </properties>
          </component>
        </children>
      </scrollpane>
    </children>
  </grid>
</form>
