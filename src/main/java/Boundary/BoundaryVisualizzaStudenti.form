<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="Boundary.BoundaryVisualizzaStudenti">
  <grid id="27dc6" binding="mainPanel" layout-manager="GridLayoutManager" row-count="2" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="15" left="15" bottom="15" right="15"/>
    <constraints>
      <xy x="20" y="20" width="700" height="500"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="lbl1" class="javax.swing.JLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Seleziona Classe:"/>
        </properties>
      </component>
      <component id="cb1" class="javax.swing.JComboBox" binding="comboClassi">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="250" height="30"/>
          </grid>
        </constraints>
        <properties/>
      </component>
      <scrollpane id="sp1">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="2" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="tb1" class="javax.swing.JTable" binding="tableStudenti">
            <constraints/>
            <properties>
              <rowHeight value="25"/>
            </properties>
          </component>
        </children>
      </scrollpane>
    </children>
  </grid>
</form>
